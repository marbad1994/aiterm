{
  "name": "shmakk-vscode",
  "displayName": "shmakk",
  "description": "shmakk AI agent — @shmakk chat participant, command correction, tool-driven tasks",
  "version": "1.0.0",
  "publisher": "shmakk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "shmakk",
        "fullName": "shmakk",
        "name": "shmakk",
        "description": "AI-supervised terminal agent — code editing, command execution, web search, skills",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "shmakk.openSettings",
        "title": "shmakk: Open Settings Panel",
        "icon": "$(gear)"
      },
      {
        "command": "shmakk.toggleSettings",
        "title": "shmakk: Toggle Settings Panel"
      },
      {
        "command": "shmakk.switchEndpoint",
        "title": "shmakk: Switch Endpoint"
      },
      {
        "command": "shmakk.loadSkill",
        "title": "shmakk: Load Skill"
      },
      {
        "command": "shmakk.listSessions",
        "title": "shmakk: List Sessions"
      },
      {
        "command": "shmakk.clearSessions",
        "title": "shmakk: Clear All Sessions"
      },
      {
        "command": "shmakk.fixCode",
        "title": "Fix with shmakk"
      },
      {
        "command": "shmakk.explainCode",
        "title": "Explain in shmakk"
      },
      {
        "command": "shmakk.sendToShmakk",
        "title": "Send to shmakk"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "shmakk.openSettings"
        },
        {
          "command": "shmakk.toggleSettings"
        },
        {
          "command": "shmakk.switchEndpoint"
        },
        {
          "command": "shmakk.loadSkill"
        },
        {
          "command": "shmakk.listSessions"
        },
        {
          "command": "shmakk.clearSessions"
        },
        {
          "command": "shmakk.explainCode"
        }
      ],
      "editor/context": [
        {
          "command": "shmakk.fixCode",
          "group": "0_shmakk@1",
          "when": "editorHasSelection"
        },
        {
          "command": "shmakk.fixCode",
          "group": "0_shmakk@1",
          "when": "!editorHasSelection"
        },
        {
          "command": "shmakk.explainCode",
          "group": "0_shmakk@2",
          "when": "editorHasSelection"
        },
        {
          "command": "shmakk.explainCode",
          "group": "0_shmakk@2",
          "when": "!editorHasSelection"
        },
        {
          "command": "shmakk.sendToShmakk",
          "group": "0_shmakk@3",
          "when": "editorHasSelection"
        },
        {
          "command": "shmakk.sendToShmakk",
          "group": "0_shmakk@3",
          "when": "!editorHasSelection"
        }
      ],
      "editor/title": [
        {
          "command": "shmakk.openSettings",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.24.0"
  }
}
